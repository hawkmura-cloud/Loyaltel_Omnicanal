# Backend Dockerfile
FROM node:18-alpine

WORKDIR /app

# Copiar package.json y package-lock.json
COPY backend/package*.json ./

# Instalar dependencias
RUN npm ci --only=production

# Copiar el resto del código
COPY backend/ ./

# Copiar configuración de Docker
COPY backend/.env.docker .env

# Exponer puerto
EXPOSE 3000

# Iniciar servidor
CMD ["node", "server.js"]
