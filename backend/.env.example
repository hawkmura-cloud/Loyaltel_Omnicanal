# Configuración del servidor
PORT=3000

# Configuración de base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=loyaltel_omnicanal
DB_USER=loyaltel_app
DB_PASSWORD=your_secure_password_here

# Configuración de JWT
# GENERA UN SECRETO ÚNICO Y SEGURO PARA PRODUCCIÓN
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=8h

# Configuración de WhatsApp Business Platform
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
