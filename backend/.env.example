# Configuración del servidor
PORT=3000

# Configuración de base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=claro_chatbot
DB_USER=claro_app
DB_PASSWORD=your_secure_password_here

# Configuración de JWT
# GENERA UN SECRETO ÚNICO Y SEGURO PARA PRODUCCIÓN
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=8h
